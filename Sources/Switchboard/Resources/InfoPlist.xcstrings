{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switchboard receives caller audio through its virtual audio device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 오디오 장치를 통해 Caller의 음성을 받습니다."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switchboard receives audio from your selected Agent application for the session."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션에서 사용할 음성을 선택한 Agent 앱에서 받습니다."
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switchboard requests administrator approval to install its audio drivers."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 드라이버를 설치할 때 관리자 승인을 요청합니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
