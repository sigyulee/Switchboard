{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switchboard relays the caller’s voice to your Agent and records the conversation as audio and text."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 상대의 음성을 Agent에 전달하고 대화를 녹음·기록합니다."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switchboard relays your Agent’s spoken replies to the caller and records them as audio and text."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent의 답변을 통화 상대에게 전달하고 녹음·기록합니다."
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switchboard requests administrator approval to install its audio drivers."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 드라이버를 설치할 때 관리자 승인을 요청합니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
